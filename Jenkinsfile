pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checkout stage started'
                echo 'Source code checkout completed'
            }
        }

        stage('Build') {
            steps {
                echo 'Building the application...'
                echo 'Build completed successfully'
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests...'
                echo 'Test completed successfully'
            }
        }
    }
}

